# Hugging Face Space reference the frontend connects to for predictions.
# Format: "username/space-name" or a full https:// Space URL.
NEXT_PUBLIC_HF_SPACE=mirzalihassan12/syndrome-model

# --- Doctor Mode (server-only; no NEXT_PUBLIC_ prefix, never sent to the browser) ---
# Create a free MongoDB Atlas M0 cluster at https://www.mongodb.com/atlas and
# paste the connection string here (manual, external account-setup step).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=deep_syndrome

# Long random string used to sign doctor login session tokens (JWT).
# Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-before-deploying
